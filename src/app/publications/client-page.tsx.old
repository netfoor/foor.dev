"use client"
import { useState, useEffect } from 'react';
import { Flex, Heading, Text, Card, Collection, Badge, Loader, View, Image, Grid } from '@aws-amplify/ui-react';
import { generateClient } from 'aws-amplify/api';
import { Schema } from '../../../amplify/data/resource';
import Container from '../components/Container';

const client = generateClient<Schema>();

export default function PublicationsClient() {
  const [publications, setPublications] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [filterType, setFilterType] = useState<string | null>(null);

  useEffect(() => {
    async function fetchPublications() {
      try {
        const result = await client.models.SocialPublications.list();
        // Sort by publication date, most recent first
        const sortedPublications = result.data.sort((a, b) => 
          new Date(b.publicationDate).getTime() - new Date(a.publicationDate).getTime()
        );
        setPublications(sortedPublications);
        setLoading(false);
      } catch (err: any) {
        console.error('Error fetching publications:', err);
        setError(err.message || 'Failed to load publications');
        setLoading(false);
      }
    }

    fetchPublications();
  }, []);

  const formatDate = (dateString: string) => {
    if (!dateString) return '';
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  };

  // Get all unique publication types for filtering
  const publicationTypes = Array.from(
    new Set(publications.map(pub => pub.type).filter(Boolean))
  );

  // Filter publications by type if a filter is selected
  const filteredPublications = filterType 
    ? publications.filter(pub => pub.type === filterType)
    : publications;

  if (loading) {
    return (
      <Flex justifyContent="center" padding="2rem">
        <Loader size="large" />
      </Flex>
    );
  }

  if (error) {
    return (
      <Text variation="error" textAlign="center" padding="2rem">
        Error loading publications: {error}
      </Text>
    );
  }

  if (publications.length === 0) {
    return (
      <Text textAlign="center" padding="2rem">
        No publications to display yet.
      </Text>
    );
  }
  return (
    <View className="flex flex-col min-h-screen">
      <View paddingTop="xl" paddingBottom="medium">
        <Container>
          <View textAlign="center" marginBottom="large">
            <Heading level={1} marginBottom="small">
              Publications
            </Heading>
            <Text fontSize="medium" color="font.secondary" maxWidth="700px" margin="0 auto">
              Articles, blog posts, and other publications sharing insights and knowledge about 
              technology, development, and innovation.
            </Text>
          </View>
        </Container>
      </View>
      
      <Container>
        {/* Filter controls */}
        {publicationTypes.length > 0 && (
          <Flex wrap="wrap" gap="0.5rem" marginBottom="1.5rem" justifyContent="center">
            <Badge 
              onClick={() => setFilterType(null)}
              style={{ 
                cursor: 'pointer',
                backgroundColor: filterType === null ? 'var(--amplify-colors-blue-60)' : 'var(--amplify-colors-neutral-20)',
                color: filterType === null ? 'white' : 'var(--amplify-colors-black)',
                fontWeight: 'bold',
                padding: '0.5rem 0.8rem'
              }}
            >
              All
            </Badge>
            
            {publicationTypes.map(type => (
              <Badge 
                key={type} 
                onClick={() => setFilterType(type)}
                style={{ 
                  cursor: 'pointer',
                  backgroundColor: filterType === type ? 'var(--amplify-colors-blue-60)' : 'var(--amplify-colors-neutral-20)',
                  color: filterType === type ? 'white' : 'var(--amplify-colors-black)',
                  fontWeight: 'bold',
                  padding: '0.5rem 0.8rem'
                }}
              >
                {type}
              </Badge>
            ))}
          </Flex>
        )}

        <Grid
          templateColumns={{ base: '1fr', medium: '1fr 1fr', large: '1fr 1fr 1fr' }}
          gap="1.5rem"
          marginBottom="2rem"
        >
          {filteredPublications.map((publication, index) => (
            <Card key={index} variation="elevated" height="100%">
              <Flex direction="column" height="100%">
                {publication.image && (
                  <Image
                    src={publication.image}
                    alt={publication.title}
                    width="100%"
                    height="200px"
                    objectFit="cover"
                    borderRadius="4px 4px 0 0"
                  />
                )}
                
                <Flex direction="column" padding="1.5rem" flex={1}>
                  <Heading level={4} marginBottom="0.5rem">{publication.title}</Heading>
                  
                  <Flex gap="0.5rem" marginBottom="1rem">
                    {publication.type && (
                      <Badge variation="info">
                        {publication.type}
                      </Badge>
                    )}
                    {publication.platform && (
                      <Badge variation="warning">
                        {publication.platform}
                      </Badge>
                    )}
                  </Flex>
                  
                  <Text marginBottom="1rem">
                    {publication.description.substring(0, 150)}
                    {publication.description.length > 150 ? '...' : ''}
                  </Text>
                  
                  <Flex justifyContent="space-between" alignItems="center" marginTop="auto">
                    <Text fontSize="0.9rem" color="var(--amplify-colors-neutral-60)">
                      {formatDate(publication.publicationDate)}
                    </Text>
                    
                    <a 
                      href={publication.publicationUrl} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      style={{ 
                        color: 'var(--amplify-colors-blue-80)', 
                        textDecoration: 'none',
                        fontWeight: 'bold'
                      }}
                    >
                      Read More →
                    </a>
                  </Flex>
                </Flex>
              </Flex>
            </Card>
          ))}
        </Grid>
        
        {filteredPublications.length === 0 && (
          <Text textAlign="center" padding="2rem">
            No publications found in this category.
          </Text>
        )}
      </Container>
    </View>
  );
}
